{
  "name": "VHS-C camcorder",
  "sensor_mm": [4.8, 3.6],
  "zoom_mm": [5.4, 43],
  "zoom_seconds": [3, 10],
  "motion": "60i",
  "lines": 240,
  "tape_minutes": 30,
  "look": {
    "format": "VHS"
  },
  "effects": [
    {"type": "resolution", "lines": 240},
    {"type": "blur", "channels": "chroma", "direction": "horizontal", "radius": 2.5, "shift": 1},
    {"type": "blur", "channels": "luma", "direction": "horizontal", "radius": 1},
    {"type": "sharpen", "amount": 0.8, "radius": 1.5},
    {"type": "ghost", "offset": [10, 0], "amount": 0.05},
    {"type": "white_balance", "drift": 0.05},
    {"type": "tone", "black_crush": 0.08, "gain": 1.1},
    {"type": "hue_saturation", "saturation": 0.8},
    {"type": "line_wobble", "amount": 0.4, "jitter": 0.15},
    {"type": "tracking", "duty": 0.15, "period": 9},
    {"type": "head_switch"},
    {"type": "dropouts", "rate": 1.5},
    {"type": "grain", "amount": 0.1, "colour": 0.6, "shadows": 0.5}
  ],
  "stamp": {
    "corner": "bottom-left",
    "lines": "date-time",
    "colour": [255, 255, 255],
    "size": 1.2
  },
  "viewfinder": {
    "text": [255, 255, 255],
    "rec": [255, 60, 60],
    "layout": [
      {"show": "box", "anchor": "top-left", "offset": [24, 24], "width": 84, "height": 34, "filled": true, "colour": [0, 0, 0], "opacity": 0.45, "when": "recording"},
      {"text": "REC", "anchor": "top-left", "offset": [30, 28], "size": 26, "colour": "rec", "when": "recording", "blink": 1},
      {"text": "PAUSE", "anchor": "top-left", "offset": [30, 28], "size": 26, "when": "!recording"},
      {"text": "SP {counter}", "anchor": "top-right", "offset": [30, 30]},
      {"text": "{remaining}", "anchor": "top-right", "offset": [30, 58], "colour": "warning", "when": "low-tape", "blink": 0.6},
      {"show": "battery", "anchor": "bottom-right", "offset": [30, 30]},
      {"text": "x{zoom}", "anchor": "bottom", "offset": [0, 30], "when": "zooming"},
      {"text": "TRIPOD {tripod}", "anchor": "bottom-left", "offset": [30, 30], "size": 18, "when": "tripod"},
      {"show": "corners", "offset": [16, 16], "size": 36, "opacity": 0.5}
    ]
  }
}

+// The camcorder's operate mode: the mouse aims with no button held, as a game's look does (the
+// camera already keeps polled input from the game while it has it). Pixels moved since the last
+// call, in the same units as the flight input's look; the cursor is held at the window's centre.
+extern "C" void DingoSDKOverlayReadMouseLook(float* x, float* y) {
+    if (!x || !y) return;
+    struct PreserveError { DWORD value = GetLastError(); ~PreserveError() { SetLastError(value); } } preserve_error;
+    *x = *y = 0;
+    thread_local POINT previous{};
+    thread_local bool looking = false;
+    const auto& s = state();
+    const HWND window = s.window.load();
+    if (!window || s.stop.load() || s.failed.load() || interactive_visible(s) || !game_window_foreground(window)) {
+        looking = false;
+        return;
+    }
+    OverlayInputAccess access;
+    const bool raw = raw_mouse_live(s);
+    const long raw_x = state().raw_mouse_x.exchange(0), raw_y = state().raw_mouse_y.exchange(0);
+    POINT current{};
+    if (!GetCursorPos(&current)) {
+        looking = false;
+        return;
+    }
+    if (looking) {
+        *x = static_cast<float>(raw ? raw_x : current.x - previous.x);
+        *y = static_cast<float>(raw ? raw_y : current.y - previous.y);
+    }
+    previous = current;
+    looking = true;
+    RECT bounds{};
+    if (GetClientRect(window, &bounds)) {
+        POINT center{(bounds.left + bounds.right) / 2, (bounds.top + bounds.bottom) / 2};
+        if (ClientToScreen(window, &center) && SetCursorPos(center.x, center.y)) previous = center;
+    }
+}
